<form action="{{ action }}" method="post" id="pp-standard-form">
  <input type="hidden" name="cmd" value="_xclick" />
  <input type="hidden" name="business" value="{{ business }}" />
  <input type="hidden" name="item_name" value="{{ item_name }}" />
  <input type="hidden" name="amount" value="{{ amount }}" />
  <input type="hidden" name="currency_code" value="{{ currency_code }}" />
  <input type="hidden" name="first_name" value="{{ first_name }}" />
  <input type="hidden" name="last_name" value="{{ last_name }}" />
  <input type="hidden" name="address1" value="{{ address1 }}" />
  <input type="hidden" name="address2" value="{{ address2 }}" />
  <input type="hidden" name="city" value="{{ city }}" />
  <input type="hidden" name="zip" value="{{ zip }}" />
  <input type="hidden" name="country" value="{{ country }}" />
  <input type="hidden" name="email" value="{{ email }}" />
  <input type="hidden" name="invoice" value="{{ order_id }}" />
  <input type="hidden" name="paymentaction" value="{{ paymentaction }}" />
  <input type="hidden" name="custom" value="{{ custom }}" />
  <input type="hidden" name="return" value="{{ return }}" />
  <input type="hidden" name="cancel_return" value="{{ cancel_return }}" />
  <input type="hidden" name="notify_url" value="{{ notify_url }}" />
  <input type="hidden" name="charset" value="utf-8" />
  <input type="hidden" name="no_note" value="1" />
  <input type="hidden" name="no_shipping" value="1" />
  <div class="text-end">
    <button type="button" id="button-confirm-paypal" class="btn btn-primary">
      <i class="fa-brands fa-paypal"></i> Pay with PayPal
    </button>
  </div>
</form>
<script type="text/javascript"><!--
$('#button-confirm-paypal').on('click', function() {
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Redirecting to PayPal...';

    $.ajax({
        url: 'index.php?route=extension/opencart/payment/pp_standard.confirm&language={{ language }}',
        dataType: 'json',
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-brands fa-paypal"></i> Pay with PayPal';
            }
            if (json['success']) {
                document.getElementById('pp-standard-form').submit();
            }
        },
        error: function() {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-brands fa-paypal"></i> Pay with PayPal';
        }
    });
});
//--></script>
