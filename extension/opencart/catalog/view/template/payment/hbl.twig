<div class="text-end">
  <button type="button" id="button-confirm-hbl" class="btn btn-primary">
    <i class="fa-solid fa-credit-card"></i> {{ button_confirm }}
  </button>
  <img src="spinner.gif" id="hbl-loader" style="display: none; position: relative; top: 6px; left: 10px; width: auto; height: 30px;">
</div>
<div id="alert-hbl"></div>
<script type="text/javascript"><!--
$('#button-confirm-hbl').on('click', function() {
    var element = this;
    var loader = document.getElementById('hbl-loader');

    $.ajax({
        url: 'index.php?route=extension/opencart/payment/hbl.confirm&language={{ language }}',
        type: 'post',
        dataType: 'json',
        beforeSend: function() {
            $(element).prop('disabled', true);
            element.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
            if (loader) loader.style.display = 'inline-block';
        },
        complete: function() {
            $(element).prop('disabled', false);
            element.innerHTML = '<i class="fa-solid fa-credit-card"></i> {{ button_confirm }}';
            if (loader) loader.style.display = 'none';
        },
        success: function(json) {
            if (json['error']) {
                $('#alert-hbl').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['redirect']) {
                window.location.href = json['redirect'];
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
