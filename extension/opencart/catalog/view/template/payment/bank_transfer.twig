<fieldset>
  <legend>{{ text_instruction }}</legend>
  <p><b>{{ text_description }}</b></p>
  <div class="border rounded p-3 mb-2">
    <p>{{ bank }}</p>
    <p>{{ text_payment }}</p>
  </div>

  <div class="payment-proof-section border rounded p-3 mb-3" style="background-color: #f8fafc; border: 1px dashed #0088cc !important;">
    <div class="mb-2">
      <label for="input-payment-proof" class="form-label fw-bold d-flex align-items-center gap-2" style="font-size: 14px; color: #1e293b; margin-bottom: 4px;">
        <i class="fa-solid fa-cloud-arrow-up text-primary" style="font-size: 18px;"></i>
        Proof of Payment Statement / Slip
      </label>
      <div class="text-muted small" style="font-size: 12px; line-height: 1.4;">
        Upload a screenshot or photo of your bank transfer statement/voucher (JPG, PNG, WEBP, PDF - Max 10MB).
      </div>
    </div>

    <!-- Upload Form Area -->
    <div id="payment-proof-input-box" {% if payment_proof %}style="display: none;"{% endif %}>
      <div class="input-group">
        <input type="file" id="input-payment-proof" name="payment_proof" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" />
        <button type="button" id="button-upload-proof" class="btn btn-primary">
          <i class="fa-solid fa-upload me-1"></i> Upload
        </button>
      </div>
      <div id="payment-proof-error" class="text-danger small mt-2" style="display: none;"></div>
      <div id="payment-proof-loading" class="text-primary small mt-2" style="display: none;">
        <i class="fa-solid fa-spinner fa-spin me-1"></i> Uploading payment proof, please wait...
      </div>
    </div>

    <!-- Uploaded File Success Area -->
    <div id="payment-proof-success-box" class="mt-2" {% if not payment_proof %}style="display: none;"{% endif %}>
      <div class="alert alert-success d-flex align-items-center justify-content-between p-2 mb-0" style="font-size: 13px;">
        <div class="d-flex align-items-center gap-2 text-truncate me-2">
          <i class="fa-solid fa-circle-check text-success fs-5 flex-shrink-0"></i>
          <span id="payment-proof-filename" class="fw-semibold text-truncate" title="{% if payment_proof %}{{ payment_proof_name }}{% endif %}">
            {% if payment_proof %}{{ payment_proof_name }}{% endif %}
          </span>
          <a id="payment-proof-view-btn" href="{% if payment_proof %}{{ payment_proof_url }}{% else %}#{% endif %}" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 flex-shrink-0" style="font-size: 12px;">
            <i class="fa-solid fa-eye"></i> View
          </a>
        </div>
        <button type="button" id="button-remove-proof" class="btn btn-sm btn-outline-danger py-0 px-2 flex-shrink-0" style="font-size: 12px;" title="Remove and upload another file">
          <i class="fa-solid fa-trash-can"></i> Remove
        </button>
      </div>
      <div id="payment-proof-thumb-box" class="mt-2 text-center" {% if not (payment_proof and payment_proof_is_image) %}style="display: none;"{% endif %}>
        <img id="payment-proof-img" src="{% if payment_proof and payment_proof_is_image %}{{ payment_proof_url }}{% endif %}" class="img-thumbnail" style="max-height: 120px; max-width: 100%; border-radius: 6px;" alt="Payment Proof Preview" />
      </div>
    </div>
  </div>

  <div class="text-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</fieldset>
<script type="text/javascript"><!--
function uploadBankTransferProof() {
    var fileInput = document.getElementById('input-payment-proof');
    if (!fileInput || !fileInput.files || !fileInput.files[0]) {
        $('#payment-proof-error').html('<i class="fa-solid fa-circle-exclamation me-1"></i> Please select an image or PDF file to upload.').show();
        return;
    }

    var formData = new FormData();
    formData.append('payment_proof', fileInput.files[0]);

    $('#payment-proof-error').hide().text('');
    $('#payment-proof-loading').show();
    $('#button-upload-proof').prop('disabled', true);

    $.ajax({
        url: 'index.php?route=extension/opencart/payment/bank_transfer.upload&language={{ language }}',
        type: 'post',
        data: formData,
        dataType: 'json',
        cache: false,
        contentType: false,
        processData: false,
        success: function(json) {
            $('#payment-proof-loading').hide();
            $('#button-upload-proof').prop('disabled', false);

            if (json['error']) {
                $('#payment-proof-error').html('<i class="fa-solid fa-circle-exclamation me-1"></i> ' + json['error']).show();
            }

            if (json['success']) {
                $('#payment-proof-filename').text(json['filename']).attr('title', json['filename']);
                $('#payment-proof-view-btn').attr('href', json['url']);
                if (json['is_image']) {
                    $('#payment-proof-img').attr('src', json['url']);
                    $('#payment-proof-thumb-box').show();
                } else {
                    $('#payment-proof-thumb-box').hide();
                }
                $('#payment-proof-input-box').slideUp(200);
                $('#payment-proof-success-box').slideDown(200);
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            $('#payment-proof-loading').hide();
            $('#button-upload-proof').prop('disabled', false);
            $('#payment-proof-error').html('<i class="fa-solid fa-circle-exclamation me-1"></i> Upload failed: ' + thrownError).show();
        }
    });
}

$(document).off('change', '#input-payment-proof').on('change', '#input-payment-proof', function() {
    uploadBankTransferProof();
});

$(document).off('click', '#button-upload-proof').on('click', '#button-upload-proof', function(e) {
    e.preventDefault();
    uploadBankTransferProof();
});

$(document).off('click', '#button-remove-proof').on('click', '#button-remove-proof', function(e) {
    e.preventDefault();
    $.ajax({
        url: 'index.php?route=extension/opencart/payment/bank_transfer.remove_upload&language={{ language }}',
        dataType: 'json',
        success: function() {
            $('#input-payment-proof').val('');
            $('#payment-proof-img').attr('src', '');
            $('#payment-proof-thumb-box').hide();
            $('#payment-proof-success-box').slideUp(200);
            $('#payment-proof-input-box').slideDown(200);
            $('#payment-proof-error').hide().text('');
        }
    });
});

$('#button-confirm').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=extension/opencart/payment/bank_transfer.confirm&language={{ language }}',
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['redirect']) {
                location = json['redirect'];
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
