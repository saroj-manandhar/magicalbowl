{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-hbl" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-hbl" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3 required">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_api_key" value="{{ payment_hbl_api_key }}" id="input-api-key" class="form-control"/>
              <div id="error-api-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3 required">
            <label for="input-merchant-id" class="col-sm-2 col-form-label">{{ entry_merchant_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_merchant_id" value="{{ payment_hbl_merchant_id }}" id="input-merchant-id" class="form-control"/>
              <div id="error-merchant-id" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-3d-secure" class="col-sm-2 col-form-label">{{ entry_three_d_secure }}</label>
            <div class="col-sm-10">
              <select name="payment_hbl_three_d_secure" id="input-3d-secure" class="form-select">
                <option value="Y"{% if payment_hbl_three_d_secure == 'Y' %} selected{% endif %}>Yes</option>
                <option value="N"{% if payment_hbl_three_d_secure == 'N' or payment_hbl_three_d_secure == '' %} selected{% endif %}>No</option>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-success-url" class="col-sm-2 col-form-label">{{ entry_success_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_success_url" value="{{ payment_hbl_success_url }}" id="input-success-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-fail-url" class="col-sm-2 col-form-label">{{ entry_fail_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_fail_url" value="{{ payment_hbl_fail_url }}" id="input-fail-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-cancel-url" class="col-sm-2 col-form-label">{{ entry_cancel_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_cancel_url" value="{{ payment_hbl_cancel_url }}" id="input-cancel-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-backend-url" class="col-sm-2 col-form-label">{{ entry_backend_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_backend_url" value="{{ payment_hbl_backend_url }}" id="input-backend-url" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_hbl_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_hbl_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_hbl_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_hbl_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_hbl_status" value="0"/>
                <input type="checkbox" name="payment_hbl_status" value="1" id="input-status" class="form-check-input"{% if payment_hbl_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_hbl_sort_order" value="{{ payment_hbl_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
