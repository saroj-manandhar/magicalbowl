{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-stripe" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-stripe" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-environment" class="col-sm-2 col-form-label">{{ entry_environment }}</label>
            <div class="col-sm-10">
              <select name="payment_stripe_environment" id="input-environment" class="form-select">
                <option value="test"{% if payment_stripe_environment == 'test' %} selected{% endif %}>{{ text_test }}</option>
                <option value="live"{% if payment_stripe_environment == 'live' %} selected{% endif %}>{{ text_live }}</option>
              </select>
              <div class="form-text">{{ entry_environment_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-test-public-key" class="col-sm-2 col-form-label">{{ entry_test_public_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_stripe_test_public_key" value="{{ payment_stripe_test_public_key }}" placeholder="{{ entry_test_public_key }}" id="input-test-public-key" class="form-control"/>
              <div class="form-text">{{ entry_test_public_key_help }}</div>
              <div id="error-test-public-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-test-secret-key" class="col-sm-2 col-form-label">{{ entry_test_secret_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_stripe_test_secret_key" value="{{ payment_stripe_test_secret_key }}" placeholder="{{ entry_test_secret_key }}" id="input-test-secret-key" class="form-control"/>
              <div class="form-text">{{ entry_test_secret_key_help }}</div>
              <div id="error-test-secret-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-live-public-key" class="col-sm-2 col-form-label">{{ entry_live_public_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_stripe_live_public_key" value="{{ payment_stripe_live_public_key }}" placeholder="{{ entry_live_public_key }}" id="input-live-public-key" class="form-control"/>
              <div class="form-text">{{ entry_live_public_key_help }}</div>
              <div id="error-live-public-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-live-secret-key" class="col-sm-2 col-form-label">{{ entry_live_secret_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_stripe_live_secret_key" value="{{ payment_stripe_live_secret_key }}" placeholder="{{ entry_live_secret_key }}" id="input-live-secret-key" class="form-control"/>
              <div class="form-text">{{ entry_live_secret_key_help }}</div>
              <div id="error-live-secret-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-success-status" class="col-sm-2 col-form-label">{{ entry_order_success_status }}</label>
            <div class="col-sm-10">
              <select name="payment_stripe_order_success_status_id" id="input-order-success-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_stripe_order_success_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ entry_order_success_status_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-failed-status" class="col-sm-2 col-form-label">{{ entry_order_failed_status }}</label>
            <div class="col-sm-10">
              <select name="payment_stripe_order_failed_status_id" id="input-order-failed-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_stripe_order_failed_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ entry_order_failed_status_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_stripe_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_stripe_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_stripe_status" value="0"/>
                <input type="checkbox" name="payment_stripe_status" value="1" id="input-status" class="form-check-input"{% if payment_stripe_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_debug }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_stripe_debug" value="0"/>
                <input type="checkbox" name="payment_stripe_debug" value="1" id="input-debug" class="form-check-input"{% if payment_stripe_debug %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ entry_debug_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_stripe_sort_order" value="{{ payment_stripe_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
