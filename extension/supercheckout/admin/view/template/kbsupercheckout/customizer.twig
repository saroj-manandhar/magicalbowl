<style type="text/css">
    .kb_error_message{
        color:red;
    }
    .kb_error_field {
        border-color: red;
    }
</style>

<script type="text/javascript">
    $(document).ready(function ()
    { 
        $(document).on("change", 'input[id="color_0"]', function() {
            var bg_color_valid = velovalidation.isColor($(this));
            if (bg_color_valid == true) {                
                $('#button_preview').css('background', $(this).val());
            }
        });
        
        $(document).on("change", 'input[id="color_1"]', function() {
            var bg_color_valid = velovalidation.isColor($(this));
            if (bg_color_valid == true) {                
                $('#button_preview').css('border', 'solid' + $(this).val());
            }
        });
        
        $(document).on("change", 'input[id="color_2"]', function() {
            var bg_color_valid = velovalidation.isColor($(this));
            if (bg_color_valid == true) {                
                $('#button_preview').css('color', $(this).val());
            }
        });
        
        $(document).on("change", 'input[id="color_3"]', function() {
            var bg_color_valid = velovalidation.isColor($(this));
            if (bg_color_valid == true) {                
                $('#button_preview').css('border-bottom', 'solid' + $(this).val());
            }
        });
        
    });    
</script>

