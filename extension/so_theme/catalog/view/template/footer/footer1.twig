<script type="text/javascript">
	function subscribe_newsletter() {
		var emailpattern = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
		var email = $('#txtemail').val();
		var d = new Date();
		var createdate = d.getFullYear() + '-' + (d.getMonth()+1) + '-' + d.getDate() + ' ' + d.getHours() + ':' + d.getMinutes() + ':' + d.getSeconds();
		var status = 0;
		var dataString = 'email='+email+'&createdate='+createdate+'&status='+status;

		if(email != "") {
			if(!emailpattern.test(email)) {
				$('.show-error').remove();
				$('.send-mail').after('<div class="alert alert-danger show-error" style="margin-top: 10px; font-size: 11px; padding: 5px;" role="alert">Invalid Email</div>');
				return false;
			} else {
				$.ajax({
					url: 'index.php?route=extension/so_theme/module/so_newletter_custom_popup|newsletter',
					type: 'post',
					data: dataString,
					dataType: 'json',
					success: function(json) {
						$('.show-error').remove();
						if(json.error == false) {
							$('.send-mail').after('<div class="alert alert-success show-error" style="margin-top: 10px; font-size: 11px; padding: 5px;" role="alert">' + json.message + '</div>');
						} else {
							$('.send-mail').after('<div class="alert alert-danger show-error" style="margin-top: 10px; font-size: 11px; padding: 5px;" role="alert">' + json.message + '</div>');
						}
						var x = document.getElementsByClassName('signup');
						for (i = 0; i < x.length; i++) {
							x[i].reset();
						}
					}
				});
				return false;
			}
		} else {
			alert("Email is required");
			$('#txtemail').focus();
			return false;
		}
	}
</script>