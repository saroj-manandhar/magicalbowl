<footer class="footer-container typefooter-{{typefooter ? typefooter : '1'}}">
	{#======	FOOTER TOP	=======#}  
	{% if footer_block2 is not empty %}
	<div class="footer-main" id="collapse-footer">
		{{ footer_block2|raw }}
	</div>
	{% endif %}

	<script type="text/javascript">
	function subscribe_newsletter_footer() {
		var emailpattern = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
		var email = $('#txtemail-footer').val();
		var d = new Date();
		var createdate = d.getFullYear() + '-' + (d.getMonth()+1) + '-' + d.getDate() + ' ' + d.getHours() + ':' + d.getMinutes() + ':' + d.getSeconds();
		var status = 0;
		var dataString = 'email=' + encodeURIComponent(email) + '&createdate=' + createdate + '&status=' + status;

		if (email != "") {
			if (!emailpattern.test(email)) {
				$('.show-error-footer').remove();
				$('#signup-footer2').after('<div class="alert alert-danger show-error-footer" style="margin-top: 10px; font-size: 12px; padding: 6px 12px;" role="alert">Invalid Email Address</div>');
				return false;
			} else {
				$.ajax({
					url: 'index.php?route=extension/so_theme/module/so_newletter_custom_popup|newsletter',
					type: 'post',
					data: dataString,
					dataType: 'json',
					success: function(json) {
						$('.show-error-footer').remove();
						if (json.error == false) {
							$('#signup-footer2').after('<div class="alert alert-success show-error-footer" style="margin-top: 10px; font-size: 12px; padding: 6px 12px;" role="alert">' + json.message + '</div>');
						} else {
							$('#signup-footer2').after('<div class="alert alert-danger show-error-footer" style="margin-top: 10px; font-size: 12px; padding: 6px 12px;" role="alert">' + json.message + '</div>');
						}
						$('#signup-footer2')[0].reset();
					}
				});
				return false;
			}
		} else {
			alert("Email is required");
			$('#txtemail-footer').focus();
			return false;
		}
	}
	</script>
	
	
	{#======	FOOTER BOTTOM	=======#} 
	<div class="footer-bottom ">
		<div class="container">		
		<div class="row">
			<div class="col-lg-6 col-md-7 col-sm-12 col-xs-12 col-12 copyright-w">	
				<div class="copyright">
					{% if soconfig.get_settings('copyright') is empty %}
						Copyright &copy; {{ "now"|date("Y") }}, Magical Singing Bowls, All Rights Reserved.
					{% else %}
						{{ soconfig.decode_entities(soconfig.get_settings('copyright'))|replace({'{year}': "now"|date("Y")}) }}
					{% endif %}
				</div>	
			</div>
			{% if soconfig.get_settings('imgpayment_status')%} 
			<div class="col-lg-6 col-md-5 col-sm-12 col-xs-12 col-12 payment-w">
				<img class="lazyload" data-sizes="auto" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="image/{{  soconfig.get_settings('imgpayment') }}"  alt="imgpayment">
			</div>
			{% endif %}
		</div>
		</div>

		
	</div>
</footer>