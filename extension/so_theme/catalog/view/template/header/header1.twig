{#=====Get variable : Config Select Block on header=====#}
{% set hidden_headercenter = soconfig.get_settings('toppanel_type') =='2'? 'hidden-compact' : '' %}
{% set hidden_headerbottom = soconfig.get_settings('toppanel_type') =='1'? 'hidden-compact' : '' %}

<header id="header" class=" variant typeheader-{{ typeheader ? typeheader : '1'}}">

	{#========================================================================
	  1. DESKTOP HEADER (100% untouched original markup for Desktop >= 992px)
	  ========================================================================#}
	<div class="header-desktop-view d-none d-lg-block hidden-sm hidden-xs">
		{#======	HEADER TOP (Utilities: Welcome, Hotline, Login/Register, Cart, Currency, Lang)	=======#}  
		<div class="header-top hidden-compact">
			<div class="container">
				<div class="row align-items-center">
					<div class="header-top-left col-xl-4 col-lg-4 col-md-12 col-12">
						{% if soconfig.get_settings('welcome_message_status') %}
							<div class="welcome-msg">
								{% if soconfig.get_settings('welcome_message') is not empty %}
									{{ soconfig.decode_entities( soconfig.get_settings('welcome_message') ) }}
								{% endif %} 
							</div>
						{% endif %}
					</div>
					<div class="header-top-right col-xl-8 col-lg-8 col-md-12 col-12">	
						<div class="top-utilities">
							{% if soconfig.get_settings('phone_status') and (soconfig.get_settings('contact_number') or telephone) %}
							<div class="telephone" >
								{% if soconfig.get_settings('contact_number') %}
									{{ soconfig.decode_entities( soconfig.get_settings('contact_number') ) }}
								{% else %}
									<ul><li><a href="tel:{{ telephone }}"><i class="fa fa-phone-square"></i>Hotline {{ telephone }}</a></li></ul>
								{% endif %}
							</div>
							{% endif %}
							
							<div class="signin-w font-title">
								<ul class="signin-link">							
									{% if logged %} 
										<li class="log logout"><i class="fa fa-unlock"></i> <a class="link-lg" href="{{ logout }} "> {{ text_logout }} </a></li>
									{% else %}   
										<li class="log login"><i class="fa fa-user"></i> <a class="link-lg" href="{{ login }} ">{{ text_login }} </a> {{ text_or }} <a href="{{ register }}">{{ text_register }}</a></li>								
									{% endif %}  			
								</ul>						
							</div>

							{% if soconfig.get_settings('lang_status') %}
							<ul class="top-link list-inline lang-curr">
								{% if currency %}<li class="currency"> {{ currency }}  </li> {% endif %}
								{% if language %} <li class="language">{{ language }} </li>	{% endif %}			
							</ul>				
							{% endif %} 					

							<div class="shopping_cart">							
							 	{{ cart }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		
		{#======	HEADER CENTER (The Iconic Brand Banner with Logo & Clean Search)	=======#} 
		<div class="header-middle {{hidden_headercenter}}">
			<div class="container header-middle-container">
				<div class="row align-items-center">			
					<div class="navbar-logo col-xl-3 col-lg-3 col-md-4 col-sm-5 col-12">
						<div class="logo">
					   		{{soconfig.get_logo()}}
					   	</div>
					</div>
					
					<div class="middle-search col-xl-5 col-lg-5 col-md-7 col-sm-7 col-12 ms-auto">	
						<div class="search-header-w">
							{{ search_block }}
						</div>				
					</div>
				</div>
			</div>
		</div>

		{#======	HEADER BOTTOM (Full Width Main Navigation Menu)	=======#}
		<div class="header-bottom {{hidden_headerbottom}}">
			<div class="container">
				<div class="row">
					<div class="main-menu col-12">
						{{ content_menu1 }}
					</div>
				</div>
			</div>
		</div>
	</div>


	{#========================================================================
	  2. MOBILE HEADER (Tailored specifically for Mobile < 992px from Reference)
	  ========================================================================#}
	<div class="header-mobile-view d-block d-lg-none hidden-md hidden-lg hidden-xl">
		{#======	MOBILE TOP BAR (Plum Bar with Language, Currency, Wishlist, Login, and Cart)	=======#}
		<div class="mobile-header-top">
			<div class="mobile-top-row-1">
				<div class="mobile-top-left-group">
					{% if language %}<div class="mobile-top-lang">{{ language }}</div>{% endif %}
					{% if currency %}<div class="mobile-top-curr">{{ currency }}</div>{% endif %}
				</div>
				
				<div class="mobile-top-center-links">
					<a href="{{ wishlist }}" class="mobile-top-link" title="Wish List"><i class="fa fa-heart"></i></a>
					{% if logged %}
						<a href="{{ account }}" class="mobile-top-link" title="Account"><i class="fa fa-user"></i></a>
					{% else %}
						<a href="{{ login }}" class="mobile-top-link" title="Login"><i class="fa fa-user"></i></a>
					{% endif %}
				</div>

				<div class="mobile-top-cart">
					<div class="shopping_cart">
						{{ cart }}
					</div>
				</div>
			</div>

			<div class="mobile-top-row-2">
				<div class="mobile-welcome-bar">
					{% if logged %}
						<span class="welcome-txt">Welcome back!</span>
						<a href="{{ logout }}" class="welcome-link"><i class="fa fa-unlock"></i> Logout</a>
					{% else %}
						<span class="welcome-txt">Welcome visitor!</span>
						<a href="{{ register }}" class="welcome-link"><i class="fa fa-unlock"></i> Register</a>
						<a href="{{ login }}" class="welcome-link"><i class="fa fa-lock"></i> Login</a>
					{% endif %}
				</div>
			</div>
		</div>

		{#======	MOBILE MIDDLE BANNER (Sunset Artwork, Centered Logo, Full Width Search Bar)	=======#}
		<div class="mobile-header-middle">
			<div class="mobile-logo-wrap">
				<div class="logo">
					{{ soconfig.get_logo() }}
				</div>
			</div>

			<div class="mobile-search-full-width">
				{{ search_block }}
			</div>
		</div>

		{#======	MOBILE BOTTOM MENU (Dark Menu Bar)	=======#}
		<div class="mobile-header-bottom">
			<div class="mobile-menu-inner">
				{{ content_menu1 }}
			</div>
		</div>

		<div class="so-megamenu-backdrop"></div>

		<script type="text/javascript">
			jQuery(document).ready(function($){
				// Open Side Drawer
				$(document).on('click', '.mobile-header-bottom .navbar-toggle, .mobile-header-bottom #show-megamenu', function(e){
					e.preventDefault();
					e.stopPropagation();
					$('.mobile-header-bottom .megamenu-wrapper').addClass('so-megamenu-active');
					$('.so-megamenu-backdrop').addClass('active');
					$('body').addClass('so-megamenu-open');
				});

				// Close Side Drawer (via X button, backdrop click, or ESC key)
				$(document).on('click', '#remove-megamenu, .so-megamenu-backdrop, .close-megamenu-btn', function(e){
					e.preventDefault();
					$('.mobile-header-bottom .megamenu-wrapper').removeClass('so-megamenu-active');
					$('.so-megamenu-backdrop').removeClass('active');
					$('body').removeClass('so-megamenu-open');
				});

				$(document).keyup(function(e) {
					if (e.key === "Escape") {
						$('.mobile-header-bottom .megamenu-wrapper').removeClass('so-megamenu-active');
						$('.so-megamenu-backdrop').removeClass('active');
						$('body').removeClass('so-megamenu-open');
					}
				});

				// Submenu accordion toggle inside side drawer
				$(document).on('click', '.mobile-header-bottom ul.megamenu > li.with-sub-menu > a, .mobile-header-bottom ul.megamenu > li.click > a', function(e){
					var $li = $(this).closest('li');
					if ($li.find('.sub-menu').length) {
						e.preventDefault();
						$li.toggleClass('active');
						$li.find('.sub-menu').first().slideToggle(200);
					}
				});
			});
		</script>
	</div>
		
</header>