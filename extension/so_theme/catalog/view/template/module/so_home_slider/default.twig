{% set count_item = list|length %}

<div class="module sohomepage-slider {{ class_suffix}}">
    {% if disp_title_module %}
      <h3 class="modtitle">{{ head_name}}</h3>
    {% endif %}

{% if pre_text %}
  <div class="form-group">
    {{ pre_text }}
  </div>
{% endif %}


<div class="modcontent">
    {% if list %} 
    <div id="sohomepage-slider{{ module}}">
         <div class="so-homeslider sohomeslider-inner-{{ module}}">
        {% for item in list %}        
            <div class="item">
              
                <a href="{{ item.url}}" title="{{ item.title}}" target="{{ item_link_target}}">
                    <img class="lazyload"   data-sizes="auto" src="{{ item.thumb}}"  alt="{{ item.title}}" />
                </a>
                <div class="sohomeslider-description">
                    <h2>{{ item.caption}}</h2>
                    {{ item.description}}              
                </div>
            </div>
        {% endfor %}
        </div>

    <script type="text/javascript">
      jQuery(document).ready(function($){
        var $slider = $(".sohomeslider-inner-{{ module }}");

        if (typeof $.fn.owlCarousel2 !== 'function') {
            // owl.carousel.js never loaded - bail out loudly instead of dying
            // silently half way through and leaving the arrows inert.
            if (window.console) {
                console.warn('so_home_slider: owlCarousel2 is not available, slider not initialised.');
            }
            return;
        }

        $slider.owlCarousel2({
            animateOut: '{{ animateOut ? animateOut : "fadeOut" }}',
            animateIn: '{{ animateIn ? animateIn : "fadeIn" }}',
            autoplay: true,
            autoplayTimeout: {{ autoplayTimeout ? autoplayTimeout : 5000 }},
            autoplaySpeed: {{ autoplaySpeed ? autoplaySpeed : 1000 }},
            smartSpeed: 600,
            autoplayHoverPause: true,
            startPosition: 0,
            mouseDrag: true,
            touchDrag: true,
            dots: true,
            autoWidth: false,
            dotClass: "owl2-dot",
            dotsClass: "owl2-dots",
            loop: true,
            nav: true,
            navText: ["<i class='fa fa-chevron-left'></i>", "<i class='fa fa-chevron-right'></i>"],
            navClass: ["owl2-prev", "owl2-next"],
            items: 1,
            responsive: {
                0: { items: 1, nav: true },
                480: { items: 1, nav: true },
                768: { items: 1, nav: true },
                992: { items: 1, nav: true },
                1200: { items: 1, nav: true }
            }
        });

        // --- Prev / next arrow navigation ------------------------------------
        // Owl builds .owl2-prev / .owl2-next inside .owl2-controls and binds its
        // own click handlers to them. Those buttons are rebuilt whenever the nav
        // re-renders (responsive refresh, lazyload, visibility check), which is
        // what left the arrows inert. Bind directly on the buttons instead, and
        // drop Owl's handler first so a click never advances two slides.
        var $wrapper = $('#sohomepage-slider{{ module }}');

        function bindHomeSliderNav() {
            var $prev = $wrapper.find('.owl2-prev'),
                $next = $wrapper.find('.owl2-next');

            if (!$prev.length && !$next.length) {
                return false;
            }

            // CSS sets pointer-events:none on .owl2-nav; make sure the buttons
            // themselves stay clickable and sit above neighbouring modules.
            $prev.add($next).css({ 'pointer-events': 'auto', 'cursor': 'pointer' });

            $prev.off('click').on('click', function (e) {
                e.preventDefault();
                $slider.trigger('prev.owl.carousel2', [600]);
            });

            $next.off('click').on('click', function (e) {
                e.preventDefault();
                $slider.trigger('next.owl.carousel2', [600]);
            });

            return true;
        }

        // Bind straight away, and keep retrying briefly in case Owl injects the
        // nav a tick later (it does when the slider starts out hidden).
        if (!bindHomeSliderNav()) {
            var navTries = 0,
                navTimer = window.setInterval(function () {
                    if (bindHomeSliderNav() || ++navTries > 20) {
                        window.clearInterval(navTimer);
                    }
                }, 100);
        }

        // Owl rebuilds the controls on refresh/resize - rebind so clicks survive.
        $slider.on('refreshed.owl.carousel2 resized.owl.carousel2', function () {
            bindHomeSliderNav();
        });
      });
    </script>
    </div>
    {% else %}  
        {{ objlang.get('text_noitem') }}
    {% endif %}
</div> <!--/.modcontent-->

{% if post_text %}
  <div class="form-group">
    {{ post_text }}
  </div>
{% endif %}


</div> 
