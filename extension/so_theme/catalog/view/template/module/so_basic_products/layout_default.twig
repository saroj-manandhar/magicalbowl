<style>
.so-basic-product .product-item-container {
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 20px;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    overflow: hidden;
}
.so-basic-product .product-item-container:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    border-color: #d8d8d8;
}
.so-basic-product .product-image-container {
    text-align: center;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 10px;
}
.so-basic-product .product-image-container img {
    max-height: 180px;
    object-fit: contain;
    margin: 0 auto;
    width: 100%;
}
.so-basic-product .button-group {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin: 8px 0;
}
.so-basic-product .button-group .btn-button {
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    color: #444;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
}
.so-basic-product .button-group .btn-button:hover {
    background: #ffaa00;
    border-color: #ffaa00;
    color: #fff;
}
.so-basic-product .button-group .addToCart {
    background: #ffb700;
    border-color: #ffb700;
    color: #111;
    font-weight: 600;
}
.so-basic-product .button-group .addToCart:hover {
    background: #e6a600;
    color: #000;
}
.so-basic-product .button-group .btn-button span {
    display: none !important; /* Hide long button text on all screens so icons stay neat */
}
.so-basic-product .right-block {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}
.so-basic-product .right-block h4 {
    margin: 6px 0;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 600;
}
.so-basic-product .right-block h4 a {
    color: #333;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Truncate to 2 lines max */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 35px;
}
.so-basic-product .right-block h4 a:hover {
    color: #ffaa00;
}
.so-basic-product .price {
    font-size: 14px;
    font-weight: 700;
    color: #ff5500;
    margin-top: 6px;
}
.so-basic-product .price .price-old {
    font-size: 12px;
    color: #999;
    text-decoration: line-through;
    margin-left: 5px;
    font-weight: 400;
}
.so-basic-product .rating {
    margin: 3px 0;
    font-size: 11px;
    color: #ffaa00;
}
@media (max-width: 767px) {
    .so-basic-product .product-image-container img {
        max-height: 130px;
    }
    .so-basic-product .product-item-container {
        padding: 8px;
        margin-bottom: 12px;
    }
    .so-basic-product .right-block h4 a {
        font-size: 12px;
        height: 31px;
    }
}
</style>

<div class="item-wrap products-list row cf {{ class_respl0 }}">

{% set j = 0 %}
	{% for product in products %}
	{% set j = j + 1 %}

	<div class="item-element item-{{j}}">
		<div class="item-inner product-item-container">
			<div class="left-block">
				<div class="product-image-container {% if product_image_num == 2 %} {{ 'second_img' }} {% endif %}">
					{% if product.special and display_sale %}
						<span class="label label-sale">{{ text_sale }}</span>
					{% endif %}
					{% if product.productNew and display_new %}
						<span class="label label-new">{{ text_new }}</span>
					{% endif %}

					{% if product_image %}
						<a href="{{ product.href }}" target="{{ item_link_target }}" title="{{ product.name }}" class="image">
							{% if product_image_num == 2 %}
								<img src="{{ product.thumb }}" class="img-thumb1 img-responsive" alt="{{ product.name }}">
								<img src="{{ product.thumb2 }}" class="img-thumb2 img-responsive" alt="{{ product.name }}">
							{% else %}
								<img src="{{ product.thumb }}" alt="{{ product.name }}" class="img-responsive">
							{% endif %}
						</a>
					{% endif %}
				</div>

				{% if display_add_to_cart or display_wishlist or display_compare %}
					<div class="button-group so-quickview">
						{% if display_add_to_cart %}
							<button type="button" class="addToCart btn-button" title="{{ text_buy }}" onclick="cart.add('{{ product.product_id }}');"><i class="fa fa-shopping-basket"></i><span>{{ text_buy }}</span></button>
						{% endif %}
						{% if display_wishlist %}
							<button type="button" class="wishlist btn-button" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i><span>{{ button_wishlist }}</span></button>
						{% endif %}
						{% if display_compare %}
							<button type="button" class="compare btn-button" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-refresh"></i><span>{{ button_compare }}</span></button>
						{% endif %}
					</div>
				{% endif %}
			</div>

			<div class="right-block">
				{% if display_title %}
					<h4>
						<a href="{{ product.href }}" target="{{ item_link_target }}">
							{{ product.name|raw }}
						</a>
					</h4>
				{% endif %}

				{% if display_description %}
					<div class="item-des">
						{{ (product.description_maxlength|raw) }}
					</div>
				{% endif %}

				<div class="caption">
					{% if display_rating %}
						<div class="rating">
							{% for i in 1..5 %}
								{% if product.rating < i %}
									<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
								{% else %}
									<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i></span>
								{% endif %}
							{% endfor %}
						</div>
					{% endif %}

					{% if display_price %}
						{% if product.price %}
							<div class="price">
								{% if not product.special %}
									<span class="price-new">{{ product.price }}</span>
								{% else %}
									<span class="price-new">{{ product.special }}</span>
									<span class="price-old">{{ product.price }}</span>
								{% endif %}
							</div>
						{% endif %}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endfor %}
</div>