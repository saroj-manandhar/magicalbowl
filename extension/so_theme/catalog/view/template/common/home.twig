{{ header }}

    <div id="content" class="{{ class }}">
    	
    {{ content_home }}
    {{ content_top }}
    {{ content_bottom }}

    <!-- Google Customer Review Box Start -->
    <div class="container msb-google-review-container">
      <div class="msb-google-review-wrap">
        <div class="msb-google-review-box">
          <div class="msb-gr-left">
            <div class="msb-gr-brand">
              <svg class="msb-google-svg" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.15z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27A7.2 7.2 0 0 1 4.9 12c0-.79.14-1.56.38-2.27V6.58H1.24A11.97 11.97 0 0 0 0 12c0 1.92.45 3.74 1.24 5.42l4.04-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.24 6.58l4.04 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              <div class="msb-gr-meta">
                <div class="msb-stars" aria-label="5 out of 5 stars">★★★★★</div>
                <span class="msb-badge-text">Google Reviews</span>
              </div>
            </div>
            <div class="msb-gr-text">
              <h3 class="msb-gr-title">Loved Your Experience with Magical Singing Bowls?</h3>
              <p class="msb-gr-desc">Your review helps sound healers, meditation practitioners, and spiritual seekers around the world discover authentic Himalayan singing bowls.</p>
            </div>
          </div>
          <div class="msb-gr-right">
            {% set msb_review_link = google_review_url ? google_review_url : config.get('config_google_review_url') %}
            {% if not msb_review_link or msb_review_link == '#' %}
              {% set msb_review_link = 'https://www.google.com/search?q=Magical+Singing+Bowls+reviews' %}
            {% endif %}
            <a href="{{ msb_review_link }}" target="_blank" rel="noopener noreferrer" class="btn-msb-google-review">
              <span class="btn-star-icon">★</span>
              <span>Write a Review on Google</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <style>
    .msb-google-review-container {
      padding: 0 15px;
    }
    .msb-google-review-wrap {
      margin: 40px 0 30px 0;
      clear: both;
    }
    .msb-google-review-box {
      background: #fffdf9;
      border: 1px solid #ebdcc5;
      border-radius: 12px;
      padding: 26px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
      box-shadow: 0 4px 18px rgba(184, 134, 11, 0.08);
      transition: all 0.3s ease;
    }
    .msb-google-review-box:hover {
      box-shadow: 0 6px 22px rgba(184, 134, 11, 0.14);
      border-color: #dfcaa8;
    }
    .msb-gr-left {
      display: flex;
      align-items: center;
      gap: 24px;
      flex: 1;
    }
    .msb-gr-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-right: 24px;
      border-right: 1px solid #ede3d2;
      min-width: 140px;
    }
    .msb-google-svg {
      margin-bottom: 6px;
    }
    .msb-stars {
      color: #e7711b;
      font-size: 19px;
      line-height: 1.2;
      letter-spacing: 2px;
    }
    .msb-badge-text {
      font-size: 11px;
      color: #777;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-top: 4px;
    }
    .msb-gr-text {
      flex: 1;
    }
    .msb-gr-title {
      margin: 0 0 6px 0;
      font-size: 20px;
      font-weight: 700;
      color: #2b2b2b;
      line-height: 1.3;
    }
    .msb-gr-desc {
      margin: 0;
      font-size: 14px;
      color: #666;
      line-height: 1.5;
    }
    .msb-gr-right {
      flex-shrink: 0;
    }
    .btn-msb-google-review {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #4285F4;
      color: #ffffff !important;
      font-size: 15px;
      font-weight: 600;
      padding: 13px 26px;
      border-radius: 30px;
      text-decoration: none !important;
      box-shadow: 0 3px 10px rgba(66, 133, 244, 0.35);
      transition: all 0.25s ease;
    }
    .btn-msb-google-review:hover {
      background: #2b6fe4;
      color: #ffffff !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(66, 133, 244, 0.45);
    }
    .btn-star-icon {
      font-size: 18px;
      color: #ffdd44;
      line-height: 1;
    }
    @media (max-width: 991px) {
      .msb-google-review-box {
        flex-direction: column;
        text-align: center;
        padding: 24px 20px;
      }
      .msb-gr-left {
        flex-direction: column;
        gap: 16px;
      }
      .msb-gr-brand {
        padding-right: 0;
        border-right: none;
        border-bottom: 1px solid #ede3d2;
        padding-bottom: 14px;
        width: 100%;
      }
      .btn-msb-google-review {
        width: 100%;
        justify-content: center;
      }
    }
    </style>
    <!-- Google Customer Review Box End -->
     </div>
   

{{ footer }}
