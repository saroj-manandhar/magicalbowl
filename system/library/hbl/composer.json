{
    "name": "hbl/opencart-payment-gateway",
    "description": "HBL Payment Gateway Library for OpenCart 3.0.2.0",
    "type": "library",
    "require": {
        "php": "^7.4",
        "nesbot/carbon": "^2.0",
        "guzzlehttp/guzzle": "^7.0",
        "brick/math": "^0.9",
        "brick/date-time": "^0.5",
        "web-token/jwt-framework": "^2.1",
        "symfony/dependency-injection": "^5.4",
        "symfony/config": "^5.4",
        "symfony/yaml": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "hbl\\": "system/library/hbl/",
            "hbl\\api\\": "system/library/hbl/api/"
        },
        "classmap": [
            "ActionRequest_NPR.php",
            "SecurityData_NPR.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}